# ============================================
# VARIABLES DE LA APLICACIÓN
# ============================================
APP_NAME="Cityra API"
APP_VERSION="1.0.0"
APP_DESCRIPTION="API para la gestión de la aplicación Cityra"
APP_PORT=3000
APP_HOST="localhost"
APP_PREFIX="api"
APP_ENV="development"

# ============================================
# VARIABLES DE SEGURIDAD
# ============================================
# Cors origins allowed separados por coma
ALLOWED_ORIGINS="http://localhost:3000"
# Cookie secret (random string min 32 characters)
COOKIE_SECRET=<secure_cookie_secret>

# ============================================
# VARIABLES DE SESIÓN
# ============================================
SESSION_SECRET=your_very_secure_session_secret_here_min_32_chars
SESSION_COOKIE_NAME="session-id"
SESSION_EXPIRES_IN_SECONDS=86400 # 1 día

# ============================================
# VARIABLES DE BASE DE DATOS (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/cityra-db?schema=public"

# ============================================
# VARIABLES DE REDIS
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>